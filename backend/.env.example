PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/hi_suvai
JWT_SECRET=your_32_byte_hex_secret_key_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# Trust Proxy setting for reverse proxy deployments (e.g. 1 for Netlify/Nginx/Render, or boolean/loopback)
TRUST_PROXY=1

# Initial Admin Seed Credentials (No default passwords in source code)
ADMIN_NAME=Rajaselvi
ADMIN_EMAIL=admin@hisuvai.com
ADMIN_PASSWORD=Set_A_Strong_Admin_Password_Here

# Allowed CORS Origins (Comma-separated)
CLIENT_URL=https://www.hisuvai.com,https://hisuvai.com,http://localhost:5000,http://localhost:8080

# Razorpay Payment Gateway Credentials (loaded only from environment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
